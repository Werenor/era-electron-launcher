{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+/?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "engineVersions": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      ]
    },
    "main": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "prepend": {
      "type": "string"
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "find": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "replace": {
            "type": "string"
          }
        },
        "required": [
          "find",
          "replace"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "external": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": [
          "source",
          "target",
          "external",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "repository",
    "version",
    "main",
    "prepend",
    "replacements",
    "files"
  ],
  "additionalProperties": false
}
