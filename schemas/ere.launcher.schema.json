{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "game": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://(?:github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+|gitgud\\.io/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+)/?$",
          "description": "HTTPS repository root only; launcher also rejects dot segments and platform page URLs."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!-)(?!.*\\.\\.)(?!.*[\\u0000-\\u001f\\u007f]).+$",
          "maxLength": 200
        }
      },
      "required": [
        "repository",
        "version"
      ],
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+/?$"
          },
          "fallback": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "repository"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
